<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ApocalypseNow.Views"
             x:Class="ApocalypseNow.Views.VolcanoPage"
             x:ClassModifier="internal"
             Title="Volcanic eruption">
    <ScrollView>
        <VerticalStackLayout>
            <v:GeneralView />

            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Volcanic ash — close all doors and windows. Use a respirator or a damp cloth to breathe through." Style="{StaticResource ListItem}" />
                        <Label Text="Ashfall — protect electronics and machinery, do not drive. Clear roofs to avoid collapse." Style="{StaticResource ListItem}" />
                        <Label Text="Use FFP3 mask and safety glasses." Style="{StaticResource ListItem}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>