<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApocalypseNow.Views.BagPage"
             x:ClassModifier="internal"
             Title="Emergency Bag (Bug-Out Bag - BOB)">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Border Padding="12">
                <VerticalStackLayout>

                    <Border>
                        <VerticalStackLayout>
                            <Label Text="Ferro rod, match, lighter, flint and steel" FontAttributes="Bold" />
                            <Label Text="Single wall stainless steel bottle with nesting cup (64 oz)" FontAttributes="Bold" />
                            <Label Text="8x10 or 10x10 heavy duty tarp in a dull natural color" FontAttributes="Bold" />
                            <Label Text="4 to 5 in full tang carbon steel fixed blade knife" FontAttributes="Bold" />
                            <Label Text="300 ft of number 36 bank line" FontAttributes="Bold" />
                            <Label Text="5 or more 55 gallon heavy duty contractor bags" FontAttributes="Bold" />
                            <Label Text="One roll of high quality Gorilla brand duct tape" FontAttributes="Bold" />
                            <Label Text="Repair system" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border>
                        <VerticalStackLayout>
                            <Label Text="Water - 4 L/person/day (3–7 days)" />
                            <Label Text="Bottled water or purification tablets, filter" />
                            <Label Text="High quality water filter (S72) rated specifically for bacteria and prozzoa" />
                            <Label Text="Chemical purification tablets (iodine or chlorine dioxide)" />
                            <Label Text="Food - 3 days' worth, non-perishables, canned goods, energy bars, dried fruits" />

                            <Label Text="First aid kit - meds for 7 days" />
                            <Label Text="Over-the-counter" />
                            <Label Text="Vitamins" />
                            <Label Text="Painkiller" />
                            <Label Text="Soap" />
                            <Label Text="Wet wipes" />
                            <Label Text="Sanitizer" />
                            <Label Text="Thermometer" />
                            <Label Text="Iodine-based tincture (Betadine)" />
                            <Label Text="FFP2/FFP3 mask" />

                            <Label Text="Hand-crank lamp" />
                            <Label Text="Headlamp" />
                            <Label Text="Candles" />

                            <Label Text="Hand-crank or battery radio" />
                            <Label Text="CB radio" />
                            <Label Text="Paper, pen" />

                            <Label Text="Solar charger" />
                            <Label Text="Spare batteries" />
                            <Label Text="Charged power bank" />

                            <Label Text="Can opener" />
                            <Label Text="Cash (small bills), precious metals, gemstones" />
                            <Label Text="Survival knife, multi-tool, pocketknife" />
                            <Label Text="Copies of documents (waterproof bag, cloud)" />
                            <Label Text="Sleeping bag, foil blanket, blanket" />
                            <Label Text="Tent" />
                            <Label Text="Map" />
                            <Label Text="Compass" />
                            <Label Text="Mirror" />
                            <Label Text="Magnifier" />
                            <Label Text="Garbage bags" />
                            <Label Text="Aluminum foil" />
                            <Label Text="Earplug" />
                            <Label Text="Rope / paracord" />
                            <Label Text="Fishing line" />
                            <Label Text="Stove / kettle" />
                            <Label Text="Bucket or barrel for storing water" />
                            <Label Text="Pepper spray" />
                            <Label Text="Loud alarm device" />
                            <Label Text="Child's favorite toy, blanket" />

                            <Label Text="Important phone numbers written on paper" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
