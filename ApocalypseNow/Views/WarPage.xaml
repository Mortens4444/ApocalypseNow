<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ApocalypseNow.Views"
             x:Class="ApocalypseNow.Views.WarPage"
             x:ClassModifier="internal"
             Title="War">
    <ScrollView>
        <VerticalStackLayout>
            <v:GeneralView />

            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Foil or darkening (cover windows). Check door locks." Style="{StaticResource NormalText}" />
                        <Label Text="Immediate protection - if fire occurs, evacuate immediately. For explosion risk, find strong cover." />
                        <Label Text="In war - know designated shelters. Store at least two weeks’ worth of food and water." />
                        <Label Text="Vigilance - follow official announcements. Prepare for self-sufficiency and long-term uncertainty." />
                        <Label Text="Undetectable storage of water." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>