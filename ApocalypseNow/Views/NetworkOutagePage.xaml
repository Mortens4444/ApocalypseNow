<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ApocalypseNow.Views"
             x:Class="ApocalypseNow.Views.NetworkOutagePage"
             x:ClassModifier="internal"
             Title="Network outages">
    <ScrollView>
        <VerticalStackLayout>
            <v:GeneralView />

            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Padding="12">
                    <VerticalStackLayout>
                        <Label Text="If mobile network fails, use SMS - it may still go through when calls or data do not." Style="{StaticResource ListItem}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>