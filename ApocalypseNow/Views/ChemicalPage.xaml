<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ApocalypseNow.Views"
             x:Class="ApocalypseNow.Views.ChemicalPage"
             x:ClassModifier="internal"
             Title="Chemical contamination">
    <ScrollView>
        <VerticalStackLayout>
            <v:GeneralView />

            <Border Padding="12">
                <VerticalStackLayout>
                    <Label Text="Chemical contamination — same protocol as for nuclear: shelter-in-place. Remove contaminated clothing and wash if exposed." Style="{StaticResource ListItem}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>