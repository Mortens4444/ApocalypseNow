<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ApocalypseNow.Views"
             x:Class="ApocalypseNow.Views.AITakeoverPage"
             x:ClassModifier="internal"
             Title="AI takeover">
    <ScrollView>
        <VerticalStackLayout>
            <v:GeneralView />

            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Radio silence." />
                        <Label Text="Air gap! Disconnect all network cables (Internet, phone)." />
                        <Label Text="Turn off Wi-Fi." />
                        <Label Text="Power off or destroy connected devices - routers, cameras, IoT, smart home systems (Alexa, Google Home, etc.)." />
                        <Label Text="Stay in groups." />
                        <Label Text="Exchange information carefully - beware of disinformation." />
                        <Label Text="Share resources within trusted groups." />
                        <Label Text="Turn off Bluetooth and NFC." />
                        <Label Text="Use old or non-smart devices when possible." />
                        <Label Text="Use USB drives only once on infected or unknown machines." />
                        <Label Text="Exchange files offline only." />
                        <Label Text="Prefer mechanical solutions (locks and keys)." />
                        <Label Text="Use older vehicles with minimal electronics." />
                        <Label Text="Avoid confrontation." />
                        <Label Text="Find shelter similar to a Faraday cage - thick metal or reinforced concrete structures - to block radiation and disrupt robotic communication." />
                        <Label Text="Avoid open or easily observable areas (drone threat). Seek natural cover." />
                        <Label Text="Avoid GPS, mobile phones, or any digital transmitters. Use only paper maps and a compass." />
                        <Label Text="Use short-wave (CB/PMR) or analog radios only for essential life-saving communication, briefly and with caution. Maintain radio silence when possible - signals can be detected, and AI can quickly break digital encryption." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>