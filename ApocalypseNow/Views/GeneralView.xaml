<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApocalypseNow.Views.GeneralView"
             x:ClassModifier="internal">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Border Padding="12">
            <VerticalStackLayout>
                <Label Text="Stay calm!" />
                <Label Text="Turn on energy saving mode on your devices" />
                <Label Text="Gather information, assess the situation" />
                <Label Text="Secure the family" />
                <Label Text="Shelter-in-place vs evacuate?" />
                <Label Text="Cooperate with neighbors" />
                <Label Text="Save water and energy" />
                <Label Text="Know who is competent at what" />
                <Label Text="A designated contact that everyone calls" />
                <Label Text="Everyone should know how to shut off the main water valve, the gas valve, and the main electrical breaker." />
                <Label Text="Two escape routes" />
                <Label Text="Close assembly point" />
                <Label Text="Distant assembly point" />
                <Label Text="Clothing: layered change of clothes, raincoat, gloves, spare socks, sturdy footwear, boots" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
