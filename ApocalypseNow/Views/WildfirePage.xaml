<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ApocalypseNow.Views"
             x:Class="ApocalypseNow.Views.WildfirePage"
             x:ClassModifier="internal"
             Title="Forest and brush fires">
    <ScrollView>
        <VerticalStackLayout>
            <v:GeneralView />

            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Wildfire preparedness - create a defensible zone around your home (clear combustible materials within ~10 meters)." />
                        <Label Text="If fire threatens - be ready to evacuate. Close windows and doors, but leave the garage door open." />
                        <Label Text="Do not keep gas cylinders indoors." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>