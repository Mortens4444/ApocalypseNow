<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ApocalypseNow.Views"
             x:Class="ApocalypseNow.Views.PowerOutagePage"
             x:ClassModifier="internal"
             Title="Power outage">
    <ScrollView>
        <VerticalStackLayout>
            <v:GeneralView />

            <VerticalStackLayout Padding="16" Spacing="12">
                <Border Padding="12">
                    <VerticalStackLayout>
                        <Label Text="Lighting - Do not use candles (fire hazard!), use LED flashlights instead." />
                        <Label Text="Communication - Listen to official announcements with a battery-powered radio." />
                        <Label Text="Food - Keep the refrigerator/freezer door closed (food can stay fresh for 24-48 hours)." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>